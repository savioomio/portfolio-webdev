# Bundles do Vite: o nome já tem hash de conteúdo, então cache eterno é seguro.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes: o arquivo não muda.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Mídia: nome fixo, então sem `immutable`. Trocar um arquivo vale em até 7 dias.
/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Arquivos de SEO sempre revalidam, senão o deploy novo não aparece.
/sitemap.xml
  Cache-Control: no-cache

/robots.txt
  Cache-Control: no-cache
