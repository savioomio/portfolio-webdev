{
  // Worker separado do site pessoal (savioomiodev): deploy aqui nunca sobrescreve o dominio principal.
  "name": "portfolio-webdev",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Rotas do react-router: path desconhecido devolve o index.html com 200, senao F5 em /projetos/x daria 404.
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "webdev.savioomiodev.com.br", "custom_domain": true }],
}
