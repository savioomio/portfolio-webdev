{
  // Worker separado do site pessoal (savioomiodev): deploy aqui nunca sobrescreve o dominio principal.
  "name": "portfolio-webdev",
  // Conta da Cloudflare (o ID nao e segredo); assim o deploy pelo CI so precisa do CLOUDFLARE_API_TOKEN.
  "account_id": "f44313ac7ffa8ff75063bb54ff40b6f0",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Cada rota tem um HTML gerado no build, servido sem barra no final para a URL canonica nao redirecionar.
    "html_handling": "drop-trailing-slash",
    // Rota desconhecida responde 404 de verdade, com o 404.html, que abre o app no navegador.
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "webdev.savioomiodev.com.br", "custom_domain": true }],
}
